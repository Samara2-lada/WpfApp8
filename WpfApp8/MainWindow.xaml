<Window x:Class="RaceWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Забег на 100 метров" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Результаты забега на 100 м" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="1" x:Name="ParticipantsGrid"
            AutoGenerateColumns="True" 
            IsReadOnly="True"
            CanUserAddRows="False" 
            GridLinesVisibility="All">
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <TextBlock Text="Средний результат: " FontSize="14"/>
            <TextBlock x:Name="AverageText" Text="—" FontSize="14"/>
            <TextBlock Text=" сек   |   Лучший результат: " FontSize="14"/>
            <TextBlock x:Name="BestText" Text="—" FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" Width="750">
            <Button Content="Загрузить данные" Width="160" Height="30" Margin="5" Click="LoadDefaultBtn_Click"/>
            <Button x:Name="ShowAddPanelBtn" Content="Добавить участника" Width="160" Height="30" Margin="5" Click="ShowAddPanelBtn_Click"/>
            <Button Content="Очистить" Width="120" Height="30" Margin="5" Click="ClearBtn_Click"/>
            <Button Content="Выход" Width="120" Height="30" Margin="5" Click="ExitBtn_Click"/>
            <Button Content="О программе" Width="120" Height="30" Click="AboutBtn_Click"/>
        </StackPanel>
        <Border Grid.Row="4" x:Name="AddPanel" Visibility="Collapsed" BorderThickness="1" CornerRadius="5"  Padding="10" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ФИО:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="NameBox" Width="180" Margin="5"/>
                <TextBlock Text="Номер:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="NumberBox" Width="60" Margin="5"/>
                <TextBlock Text="Результат (сек):" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="ResultBox" Width="60" Margin="5"/>
                <Button Content="Сохранить" Width="90" Height="25" Margin="10,5,5,5" Click="SaveNewParticipant_Click"/>
                <Button Content="Отмена" Width="80" Height="25" Margin="5" Click="CancelAdd_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>